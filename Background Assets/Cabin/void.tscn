metadata/_custom_type_script = "uid://cug1l4ymh31cf"

[sub_resource type="Resource" id="Resource_t46nd"]
script = ExtResource("7_7p5k0")
speaker_img = ExtResource("6_1el52")
text = "[center][color=black]  Oh how queer! HOW QUEER!"
text_speed = 25.0
metadata/_custom_type_script = "uid://cug1l4ymh31cf"

[sub_resource type="Resource" id="Resource_cdv3i"]
script = ExtResource("7_7p5k0")
speaker_img = ExtResource("6_1el52")
text = "[center][color=black]  A human sent too me?  "
metadata/_custom_type_script = "uid://cug1l4ymh31cf"

[sub_resource type="Resource" id="Resource_muyvn"]
script = ExtResource("7_7p5k0")
speaker_img = ExtResource("6_1el52")
text = "[center][color=black]  But you're not truly human[shake] ARE [/shake]you? "
text_speed = 20.0
metadata/_custom_type_script = "uid://cug1l4ymh31cf"

[sub_resource type="Resource" id="Resource_7p5k0"]
script = ExtResource("7_7p5k0")
speaker_img = ExtResource("7_nf6be")
text = "[center][color=black]  Where are my manners,   I know to treat a guest!"
metadata/_custom_type_script = "uid://cug1l4ymh31cf"

[sub_resource type="Resource" id="Resource_6kav8"]
script = ExtResource("7_7p5k0")
speaker_img = ExtResource("7_nf6be")
text = "[color=black]  Just come my way..."
metadata/_custom_type_script = "uid://cug1l4ymh31cf"

[sub_resource type="Resource" id="Resource_pqvi1"]
script = ExtResource("7_7p5k0")
text = "
[center][shake rate=20][color=black]TO INVITE YOU TO DEATH!"
text_speed = 15.0
metadata/_custom_type_script = "uid://cug1l4ymh31cf"

[sub_resource type="Resource" id="Resource_2kvnt"]
