[sub_resource type="Resource" id="Resource_cqy0m"]
script = ExtResource("7_7p5k0")
speaker_img = ExtResource("9_nf6be")
text = "[center][color=black]  Cmon, I have to enjoy myself yknow? "
auto_advance = true
auto_advance_delay = 0.7
metadata/_custom_type_script = "uid://cug1l4ymh31cf"

[sub_resource type="Resource" id="Resource_awdq2"]
